rules_version = '2';

// Obrázky produktů: číst může kdokoli, nahrávat a mazat jen obsluha.
// Nasazení: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
  }
}
