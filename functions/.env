# Konfigurace Cloud Functions (načte se automaticky při deployi).
# Nejsou tajné (refresh token sem NEPATŘÍ — ten jde do Secret Manageru, viz DOTYKACKA_NAVOD.md).

# Cloud ID provozovny — vrátí ho Dotykačka po přihlášení v connectoru (parametr cloudid v URL)
DOTYKACKA_CLOUD_ID=304899966

# ID pobočky (pokladny) — vypíše ho tools/dotykacka-test.mjs
DOTYKACKA_BRANCH_ID=191033401

# Kolik Kč útraty = 1 věrnostní bod
KC_PER_POINT=10
