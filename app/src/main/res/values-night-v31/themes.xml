<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: systémová úvodní obrazovka v barvách CannaClub místo tmavě šedé -->
<resources>
    <style name="Theme.CannaApp" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/canna_cream</item>
        <item name="android:windowSplashScreenBackground">@color/canna_cream</item>
    </style>
</resources>
